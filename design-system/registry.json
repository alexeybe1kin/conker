{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "conker",
  "homepage": "https://github.com/alexeybe1kin/conker",
  "items": [
    {
      "name": "conker-foundation",
      "type": "registry:ui",
      "title": "Conker foundation",
      "description": "Radix components, semantic tokens, theme controls and evidence-bound status. Import the supplied stylesheet once.",
      "dependencies": [
        "react@19.2.8",
        "react-dom@19.2.8",
        "radix-ui@1.6.7",
        "cn@0.2.6",
        "class-variance-authority@0.7.1",
        "lucide-react@1.30.0",
        "tailwindcss@4.3.3",
        "tw-animate-css@1.4.0"
      ],
      "files": [
        {
          "path": "src/components/ui/badge.tsx",
          "type": "registry:ui"
        },
        {
          "path": "src/components/ui/button.tsx",
          "type": "registry:ui"
        },
        {
          "path": "src/components/ui/card.tsx",
          "type": "registry:ui"
        },
        {
          "path": "src/components/ui/dialog.tsx",
          "type": "registry:ui"
        },
        {
          "path": "src/components/ui/field.tsx",
          "type": "registry:ui"
        },
        {
          "path": "src/components/ui/input.tsx",
          "type": "registry:ui"
        },
        {
          "path": "src/components/ui/label.tsx",
          "type": "registry:ui"
        },
        {
          "path": "src/components/ui/separator.tsx",
          "type": "registry:ui"
        },
        {
          "path": "src/components/ui/sheet.tsx",
          "type": "registry:ui"
        },
        {
          "path": "src/components/ui/skeleton.tsx",
          "type": "registry:ui"
        },
        {
          "path": "src/components/ui/table.tsx",
          "type": "registry:ui"
        },
        {
          "path": "src/components/ui/tabs.tsx",
          "type": "registry:ui"
        },
        {
          "path": "src/components/ui/tooltip.tsx",
          "type": "registry:ui"
        },
        {
          "path": "src/status.tsx",
          "type": "registry:ui"
        },
        {
          "path": "src/theme.tsx",
          "type": "registry:ui"
        },
        {
          "path": "src/styles.css",
          "type": "registry:file",
          "target": "src/styles/conker.css"
        }
      ]
    }
  ]
}
